  "text": {
    "headline": "Simple to setup.",
    "section_title_1": "Frequently asked questions.",
    "section_title_2": "One price. No subscription.",
    "body_text_1": "Create palettes in Figma & FigJam based on your color styles easily with Droplette, AI that works for you.",
    "body_text_2": "Select the colors you want to work with, or hook up your styles and go.",
    "body_text_3": "Select from your frames",
    "body_text_4": "Grab some frames and Droplette will extract colors. The AI will use use these a basis for creating your unique palettes.",
    "body_text_5": "Sync with your styles",
    "body_text_6": "Sync your color styles with Droplette to inform the AI what colors it can work with, helping you keep on brand and on track.",
    "body_text_7": "Like your palette but want to tweak it? No problem. Adjust your generated palette to suit your needs with ease.",
    "body_text_8": "Iterate on your palette as much as you like. Suggest colors to take forward or start again from scratch.",
    "body_text_9": "Bring your own API key for OpenAI. Droplette is a single payment. Special launch price of $9.",
    "cta_text_1": "Try in Figma",
    "cta_text_2": "Buy license $9 $20",
    "cta_text_3": "Try in Figma"
  },
