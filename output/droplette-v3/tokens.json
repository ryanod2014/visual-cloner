  "animations": {
    "dot_pulse": {
      "selector": ".dots .circle",
      "type": "pulse",
      "tokens": {
        "duration": {
          "value": "4s",
          "cssVar": "--animation-dot-duration",
          "purpose": "How fast dots pulse in/out"
        },
        "easing": {
          "value": "ease-in-out",
          "cssVar": "--animation-dot-easing",
          "purpose": "Animation feel (smooth vs snappy)"
        },
        "stagger_base": {
          "value": "0.3s",
          "cssVar": "--animation-stagger-base",
          "purpose": "Delay between dot animations"
        }
      }
    },
    "button_shine": {
      "selector": ".shine",
      "type": "sweep",
      "tokens": {
        "duration": {
          "value": "6s",
          "purpose": "Shine sweep cycle time"
        },
        "travel_distance": {
          "value": "600px",
          "purpose": "How far shine travels"
        }
      }
    },
